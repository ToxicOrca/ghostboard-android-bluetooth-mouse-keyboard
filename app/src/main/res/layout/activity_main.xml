<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark"
    android:fitsSystemWindows="true">

    <!-- Status bar -->
    <FrameLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface_dark">

        <!-- Centered status: dot + text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/status_disconnected" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/not_connected"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Left-side buttons: Exit + Connect -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Exit button -->
            <Button
                android:id="@+id/exitButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:text="✕"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:minWidth="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <!-- Right-side buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- KB/TP toggle (landscape) or Keyboard toggle (portrait) -->
            <Button
                android:id="@+id/fullscreenKbButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="KB"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <!-- Settings button -->
            <Button
                android:id="@+id/settingsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:text="⚙"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:minWidth="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ================= 文本输入中继栏（需求 A） ================= -->
    <LinearLayout
        android:id="@+id/relayBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="2dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- 输入框：点击即调起系统默认输入法（搜狗/微信输入法/系统拼音/语音） -->
            <EditText
                android:id="@+id/relayInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@color/key_bg"
                android:hint="@string/relay_hint"
                android:importantForAutofill="no"
                android:imeOptions="actionSend|flagNoExtractUi|flagNoFullscreen"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:scrollHorizontally="true"
                android:textColor="@color/key_text"
                android:textColorHint="@color/text_secondary"
                android:textCursorDrawable="@null"
                android:textSize="14sp" />

            <!-- 发送按钮：单击发送；长按打开中继模式菜单 -->
            <Button
                android:id="@+id/relaySendButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:minWidth="0dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/relay_send"
                android:textColor="@color/accent"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 拼音预演 + 当前模式标签 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/relayPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="start"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/relayModeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@color/key_bg"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/accent"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main content: keyboard left, trackpad right (or swapped based on settings) -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Keyboard area -->
        <com.example.remoteinput.ui.CompactKeyboardView
            android:id="@+id/keyboardView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp" />

        <!-- Trackpad area -->
        <FrameLayout
            android:id="@+id/trackpadContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.example.remoteinput.ui.TrackpadView
                android:id="@+id/trackpadView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Mouse buttons row at bottom of trackpad -->
            <LinearLayout
                android:id="@+id/mouseButtons"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:orientation="horizontal">

                <View
                    android:id="@+id/leftClickButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="1dp"
                    android:background="@color/key_bg" />

                <View
                    android:id="@+id/rightClickButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    android:background="@color/key_bg" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Hidden EditText to capture soft keyboard input in portrait mode -->
    <EditText
        android:id="@+id/hiddenInput"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0"
        android:background="@android:color/transparent"
        android:textColor="@android:color/transparent"
        android:cursorVisible="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions|textVisiblePassword"
        android:imeOptions="flagNoExtractUi|flagNoFullscreen" />
</LinearLayout>
