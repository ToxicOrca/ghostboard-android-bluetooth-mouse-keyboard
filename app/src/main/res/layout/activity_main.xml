<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_dark">

    <!-- Status bar -->
    <FrameLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/surface_dark">

        <!-- Centered status: dot + text -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/status_disconnected" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/not_connected"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Connect button pinned left -->
        <Button
            android:id="@+id/connectButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="8dp"
            android:text="@string/connect"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />

        <!-- KB/TP toggle pinned right -->
        <Button
            android:id="@+id/fullscreenKbButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:text="KB"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </FrameLayout>

    <!-- Main content: keyboard left, trackpad right -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Keyboard area (left side) -->
        <com.example.remoteinput.ui.CompactKeyboardView
            android:id="@+id/keyboardView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp" />

        <!-- Trackpad area (right side) -->
        <FrameLayout
            android:id="@+id/trackpadContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <com.example.remoteinput.ui.TrackpadView
                android:id="@+id/trackpadView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Mouse buttons row at bottom of trackpad -->
            <LinearLayout
                android:id="@+id/mouseButtons"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_gravity="bottom"
                android:orientation="horizontal">

                <View
                    android:id="@+id/leftClickButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="1dp"
                    android:background="@color/key_bg" />

                <View
                    android:id="@+id/rightClickButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="1dp"
                    android:background="@color/key_bg" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
